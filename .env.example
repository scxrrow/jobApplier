# Sources d'offres interrogees par `jobot fetch` : francetravail, apec.
# L'APEC ne demande aucun identifiant. Retire 'francetravail' de la liste si
# tu n'as pas (ou pas encore) de compte francetravail.io.
JOBOT_SOURCES=francetravail,apec

# France Travail — https://francetravail.io  (Mon espace > Mes applications)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# LLM (scoring des offres + import du CV).
#
# Gemini natif :
#   JOBOT_LLM_PROVIDER=gemini
#   JOBOT_LLM_MODEL=gemini-flash-latest
#   JOBOT_LLM_API_KEY=...            # https://aistudio.google.com/apikey
#
# Modele local (LM Studio, Ollama...) — aucune cle requise :
#   JOBOT_LLM_PROVIDER=lmstudio      # ou: ollama
#   JOBOT_LLM_MODEL=qwen2.5-coder-14b-instruct
#
# OpenAI / OpenRouter :
#   JOBOT_LLM_PROVIDER=openai        # ou: openrouter
#   JOBOT_LLM_MODEL=gpt-4o-mini
#   JOBOT_LLM_API_KEY=...
#
# Toute autre API OpenAI-compatible :
#   JOBOT_LLM_PROVIDER=openai_compat
#   JOBOT_LLM_BASE_URL=https://mon-serveur/v1
#   JOBOT_LLM_MODEL=...
JOBOT_LLM_PROVIDER=gemini
JOBOT_LLM_MODEL=gemini-flash-latest
JOBOT_LLM_API_KEY=
JOBOT_LLM_BASE_URL=

# SMTP — envoi des candidatures du canal 'email' (etape 5).
# Gmail / Outlook : cree un MOT DE PASSE D'APPLICATION, jamais le mot de passe
# du compte. Gmail : smtp.gmail.com / 587. Outlook : smtp-mail.outlook.com / 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=          # optionnel : adresse d'expedition si differente de SMTP_USER
SMTP_TLS=starttls   # starttls | ssl (port 465) | none (relais local)

# Criteres de recherche (voir filters.py pour le detail)
JOBOT_DEPARTEMENTS=35,75
JOBOT_MOTS_CLES=cybersecurite,devops,pentest,SOC,administrateur systeme
JOBOT_TYPES_CONTRAT=E2,CDI
JOBOT_ALTERNANCE_ONLY=true
